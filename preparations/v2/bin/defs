#!/usr/bin/env ruby
# frozen_string_literal: true
#
# defs — check, draw, and read the definition groups in ../def/
#
#   defs check      every file parses; every @{term} and relation target is a defined term;
#                   no term defined twice; every group term is introduced in **BOLD CAPITALS**;
#                   every group is in _outline.yaml
#   defs dot        Graphviz of every term that has relations, edges labelled "relation {min,max}"
#   defs overview   the intros, in reading order, as one text
#   defs terms      one line per term: term, group, definition

require 'yaml'

DEF_DIR = File.expand_path('../def', __dir__)

def load_groups
  outline = YAML.load_file(File.join(DEF_DIR, '_outline.yaml'))
  files   = Dir[File.join(DEF_DIR, 'def-*.yaml')].map { |f| File.basename(f, '.yaml') }.sort
  groups  = {}
  problems = []
  (outline | files).each do |g|
    path = File.join(DEF_DIR, "#{g}.yaml")
    unless File.exist?(path)
      problems << "#{g}: listed in _outline.yaml but there is no such file"
      next
    end
    begin
      groups[g] = YAML.load_file(path)
    rescue StandardError => e
      problems << "#{g}: does not parse: #{e.message}"
    end
  end
  (files - outline).each { |g| problems << "#{g}: not listed in _outline.yaml" }
  [outline & groups.keys | (groups.keys - outline), groups, problems]
end

# @{segments} -> segment ; @{inner-dependencies} -> inner-dependency ; @{inboxes} -> inbox
def resolve(word, terms, plurals)
  w = word.downcase
  return w if terms.key?(w)
  return plurals[w] if plurals.key?(w)
  [w.sub(/ies\z/, 'y'), w.sub(/es\z/, ''), w.sub(/s\z/, '')].find { |c| terms.key?(c) }
end

def each_text(node, &blk)
  case node
  when String then blk.call(node)
  when Array  then node.each { |n| each_text(n, &blk) }
  when Hash   then node.each_value { |n| each_text(n, &blk) }
  end
end

order, groups, problems = load_groups
terms   = {}   # term => group
plurals = {}   # declared plural => term
groups.each do |g, data|
  listed = Array(data['term-group'])
  defined = (data['terms'] || {}).keys
  (listed - defined).each { |t| problems << "#{g}: '#{t}' is in term-group but has no entry under terms" }
  (defined - listed).each { |t| problems << "#{g}: '#{t}' is defined but not in term-group" }
  defined.each do |t|
    problems << "#{g}: '#{t}' is already defined in #{terms[t]}" if terms.key?(t)
    terms[t] = g
    pl = data['terms'][t].is_a?(Hash) ? data['terms'][t]['pl'] : nil
    plurals[pl] = t if pl && !pl.start_with?('-')
  end
end

case ARGV[0]
when 'check'
  groups.each do |g, data|
    problems << "#{g}: status is missing" unless data['status']
    intro = data['intro'].to_s
    problems << "#{g}: intro is missing" if intro.strip.empty?
    Array(data['term-group']).each do |t|
      problems << "#{g}: '#{t}' is not introduced in **BOLD CAPITALS** in the intro" unless intro.include?("**#{t.upcase}**")
    end
    each_text(data) do |text|
      text.scan(/@\{([^}]+)\}/).flatten.each do |ref|
        problems << "#{g}: @{#{ref}} does not resolve to a defined term" unless resolve(ref, terms, plurals)
      end
    end
    (data['terms'] || {}).each do |t, body|
      problems << "#{g}: '#{t}' has no def" unless body.is_a?(Hash) && body['def']
      Array(body.is_a?(Hash) ? body['rels'] : nil).each do |r|
        problems << "#{g}: '#{t}' has a relation with no name" unless r['rel']
        problems << "#{g}: '#{t}' has a relation whose name parsed as #{r['rel'].inspect}, not text (quote words like on, off, yes, no)" unless r['rel'].is_a?(String)
        problems << "#{g}: '#{t}' relation '#{r['rel']}' has no cardinality" unless r['card'].to_s =~ /\A\{\d+,(\d+|N)\}\z/
        next if r['informal']
        Array(r['to']).each do |target|
          problems << "#{g}: '#{t}' relation '#{r['rel']}' points at '#{target}', which is not a defined term" unless terms.key?(target)
        end
        problems << "#{g}: '#{t}' relation '#{r['rel']}' has neither a target nor an informal one" if r['to'].nil?
      end
    end
  end
  if problems.empty?
    nrels = groups.values.sum { |d| (d['terms'] || {}).values.sum { |b| Array(b['rels']).size } }
    puts "ok: #{groups.size} groups, #{terms.size} terms, #{nrels} relations, nothing unresolved"
  else
    puts problems
    exit 1
  end

when 'dot'
  palette = %w[#e6f3ee #efeaf3 #e8eef6 #fbf1e3 #f3e9e9 #eaf3f6 #f1f3e6 #f6eaf3]
  used = {}
  edges = []
  groups.each do |_g, data|
    (data['terms'] || {}).each do |t, body|
      Array(body['rels']).each do |r|
        next if r['informal']
        Array(r['to']).each do |target|
          used[t] = true
          used[target] = true
          edges << [t, target, r['rel'], r['card']]
        end
      end
    end
  end
  id = ->(t) { t.gsub(/[^a-z0-9]/, '_') }
  puts '// Generated by bin/defs dot from def/*.yaml. Do not edit; edit the definitions.'
  puts '// An edge reads from its tail: "tail  relation {min,max}  head".'
  puts 'digraph lexicon {'
  puts '  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=1.1, labelloc=t,'
  puts '         label=<<b>The v2 lexicon: terms and their relations</b><br/><font point-size="9">Each edge reads from its tail: tail, relation {min,max}, head. Boxes group terms defined together.</font>>];'
  puts '  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor=white];'
  puts '  edge  [fontname="Helvetica", fontsize=8, color="#555555", arrowsize=0.6];'
  order.each_with_index do |g, i|
    members = (groups[g]['terms'] || {}).keys.select { |t| used[t] }
    next if members.empty?
    puts "  subgraph cluster_#{id.call(g)} {"
    puts "    label=\"#{g.sub('def-', '')}\"; style=\"rounded,filled\"; color=\"#bbbbbb\"; fillcolor=\"#{palette[i % palette.size]}\"; fontsize=9; fontcolor=\"#555555\";"
    members.each { |t| puts "    #{id.call(t)} [label=\"#{t}\"];" }
    puts '  }'
  end
  edges.each do |from, to, rel, card|
    style = rel == 'is-a' ? ', style=dashed' : ''
    puts "  #{id.call(from)} -> #{id.call(to)} [label=\"#{rel} #{card}\"#{style}];"
  end
  puts '}'

when 'overview'
  order.each do |g|
    data = groups[g]
    puts "## #{Array(data['term-group']).join(', ')}"
    puts
    puts data['intro'].to_s.strip
    puts
  end

when 'terms'
  order.each do |g|
    (groups[g]['terms'] || {}).each { |t, body| puts "#{t}\t#{g}\t#{body['def']}" }
  end

else
  warn 'usage: defs check | dot | overview | terms'
  exit 2
end
